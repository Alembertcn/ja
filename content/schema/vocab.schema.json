{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Alembertcn/ja/content/schema/vocab.schema.json",
  "title": "日语词库（VocabBook）",
  "description": "按记忆维度分组的全量词表。App 课文列表底部入口拉取。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "titleZh", "level", "updatedAt", "groups"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "titleZh": { "type": "string", "minLength": 1 },
    "level": { "type": "string", "enum": ["N5", "N4", "N3", "N2", "N1"] },
    "subtitle": { "type": "string" },
    "updatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/group" }
    }
  },
  "$defs": {
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "words"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["similarity", "theme", "pattern", "function", "sound", "core"],
          "description": "similarity=易混近义 theme=内容主题 pattern=构词 function=功能词 sound=拟声拟态 core=高频核心"
        },
        "hint": { "type": "string", "description": "本组记忆提示" },
        "words": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/word" }
        }
      }
    },
    "word": {
      "type": "object",
      "additionalProperties": false,
      "required": ["word", "reading", "zh"],
      "properties": {
        "word": { "type": "string", "minLength": 1 },
        "reading": { "type": "string", "minLength": 1 },
        "zh": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      }
    }
  }
}
