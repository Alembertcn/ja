  "titleZh": "第一次见面",
  "stage": "P0",
  "week": 1,
  "level": "N5",
  "type": "dialogue",
  "scene": "公司入职第一天，新人小李和同事田中初次见面",
  "grammarModules": ["G0-01", "G0-03", "G0-11", "G0-13", "G0-16", "G0-22"],
  "vocabTopic": "V0",
  "tags": ["寒暄", "自我介绍", "职场"],
