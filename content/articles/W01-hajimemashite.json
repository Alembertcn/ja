  "titleZh": "第一次见面",
  "stage": "P0",
  "week": 1,
  "level": "N5",
  "type": "dialogue",
  "scene": "公司入职第一天的早晨，新人小李和同事田中初次见面",
  "grammarModules": ["G0", "V0", "S0"],
  "vocabTopic": "V0",
  "tags": ["寒暄", "自我介绍", "职场"],
