  "week": 1,
  "level": "N5",
  "type": "dialogue",
  "scene": "日语教室傍晚，学生小王向佐藤老师确认物品与身份用语",
  "grammarModules": ["G0", "V0", "S0"],
  "vocabTopic": "V0",
  "tags": ["寒暄", "疑问", "否定", "指示词", "教室"],
