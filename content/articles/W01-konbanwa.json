      ],
      "vocab": [
        { "word": "わたし", "reading": "わたし", "pos": "代名詞", "zh": "我" },
        { "word": "名前", "reading": "なまえ", "pos": "名詞", "zh": "名字" }
      ],
      "isSentenceEnd": true
    },
    {
