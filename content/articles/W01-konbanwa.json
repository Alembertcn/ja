      "zh": "晚上好。",
      "grammar": [
        {
          "module": "S0",
          "point": "こんばんは",
          "explain": "傍晚至夜间的问候。句尾的「は」读 wa，不是 ha。与「おはようございます」「こんにちは」构成一天的三套礼貌问候。"
        }
      ],
      "vocab": [
        { "word": "こんばんは", "reading": "こんばんは", "pos": "感動詞", "zh": "晚上好" }
      ],
      "isSentenceEnd": true
    },
    {
      "id": "l02",
      "speaker": "佐藤",
      "jp": "王さん、こんばんは。どうぞ。",
      "reading": "わんさん、こんばんは。どうぞ。",
      "romaji": "Wan-san, konbanwa. dōzo.",
      "furigana": [{ "start": 0, "len": 1, "ruby": "わん" }],
      "zh": "小王，晚上好。请进。",
      "grammar": [
        {
          "module": "G0",
          "point": "～さん",
          "explain": "称呼对方用「姓／名＋さん」。老师叫得出学生的名字，说明两人早就认识，这不是初次见面。"
        },
        {
          "module": "S0",
          "point": "どうぞ",
          "explain": "请对方做某事。站在门口说就是「请进」，递东西时是「请收下」，让座时是「请坐」，具体意思看场合。"
        }
      ],
      "vocab": [
        { "word": "どうぞ", "reading": "どうぞ", "pos": "副詞", "zh": "请" }
      ],
      "isSentenceEnd": true
    },
    {
      "id": "l03",
      "speaker": "王",
      "jp": "すみません。あの人はだれですか。",
      "reading": "すみません。あのひとはだれですか。",
      "romaji": "sumimasen. ano hito wa dare desu ka.",
      "furigana": [{ "start": 8, "len": 1, "ruby": "ひと" }],
      "zh": "不好意思。那个人是谁？",
      "grammar": [
        {
          "module": "S0",
          "point": "すみません",
          "explain": "劳驾、借光。用来在发问前引起对方注意，比张口就问礼貌得多。"
        },
        {
          "module": "G0",
          "point": "あの＋名詞",
          "explain": "离说话人和听话人都较远时用「あの／あれ」。问人的身份用「だれ（誰）」。"
        }
      ],
      "vocab": [
        { "word": "すみません", "reading": "すみません", "pos": "感動詞", "zh": "对不起／劳驾" },
        { "word": "あの", "reading": "あの", "pos": "連体詞", "zh": "那个～（远）" },
        { "word": "人", "reading": "ひと", "pos": "名詞", "zh": "人" },
        { "word": "だれ", "reading": "だれ", "pos": "代名詞", "zh": "谁" }
      ],
      "isSentenceEnd": true
