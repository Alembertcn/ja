      "vocab": [
        { "word": "日本人", "reading": "にほんじん", "pos": "名詞", "zh": "日本人" },
        { "word": "先生", "reading": "せんせい", "pos": "名詞", "zh": "老师" }
      ],
      "isSentenceEnd": true
