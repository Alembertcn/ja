  "lines": [
    {
      "id": "l01",
      "jp": "わたしの会社は駅の近くにあります。",
      "reading": "わたしのかいしゃはえきのちかくにあります。",
      "romaji": "watashi no kaisha wa eki no chikaku ni arimasu.",
      "furigana": [
        { "start": 4, "len": 2, "ruby": "かいしゃ" },
        { "start": 7, "len": 1, "ruby": "えき" },
        { "start": 9, "len": 1, "ruby": "ちか" }
      ],
      "zh": "我的公司在车站附近。",
      "grammar": [
        {
          "module": "G0-04",
          "point": "〔东西〕は〔场所〕に あります",
          "explain": "介绍已知事物的位置：话题「わたしの会社」用「は」提出，地点后加「に」，建筑用「あります」。"
        }
      ],
      "vocab": [
        { "word": "近く", "reading": "ちかく", "pos": "名詞", "zh": "附近" }
      ],
      "isSentenceEnd": true
    },
    {
      "id": "l02",
      "jp": "駅から会社まで五分です。",
      "reading": "えきからかいしゃまでごふんです。",
      "romaji": "eki kara kaisha made gofun desu.",
      "furigana": [
        { "start": 0, "len": 1, "ruby": "えき" },
        { "start": 3, "len": 2, "ruby": "かいしゃ" },
        { "start": 7, "len": 2, "ruby": "ごふん" }
      ],
      "zh": "从车站到公司要五分钟。",
      "grammar": [
        {
          "module": "G0-03",
          "point": "A から B まで",
          "explain": "「从 A 到 B」。「から」是起点（W01 已学），「まで」是终点。地点、时间都能用：九時から五時まで（九点到五点）。"
        }
      ],
      "vocab": [
        { "word": "五分", "reading": "ごふん", "pos": "名詞", "zh": "五分钟", "note": "分的读法会变：一分 いっぷん、三分 さんぷん、五分 ごふん、十分 じゅっぷん" }
      ],
      "isSentenceEnd": true
    },
    {
      "id": "l03",
      "jp": "会社の前にコンビニがあります。",
      "reading": "かいしゃのまえにこんびにがあります。",
      "romaji": "kaisha no mae ni konbini ga arimasu.",
      "furigana": [
        { "start": 0, "len": 2, "ruby": "かいしゃ" },
        { "start": 3, "len": 1, "ruby": "まえ" }
      ],
      "zh": "公司前面有一家便利店。",
      "grammar": [
        {
          "module": "G0-04",
          "point": "〔场所〕に〔东西〕が あります",
          "explain": "告诉对方「某处有某物」，新出现的东西用「が」。和 l01 对比：l01 是「公司在哪」，这句是「那儿有什么」，语序和助词都跟着变。"
        }
      ],
      "vocab": [
        { "word": "コンビニ", "reading": "こんびに", "pos": "名詞", "zh": "便利店", "note": "コンビニエンスストア 的缩略" }
      ],
      "isSentenceEnd": true
    },
    {
      "id": "l04",
      "jp": "わたしは毎朝そこでコーヒーを買います。",
      "reading": "わたしはまいあさそこでこーひーをかいます。",
      "romaji": "watashi wa maiasa soko de kōhī o kaimasu.",
      "furigana": [
        { "start": 4, "len": 2, "ruby": "まいあさ" },
        { "start": 14, "len": 1, "ruby": "か" }
      ],
      "zh": "我每天早上在那儿买咖啡。",
      "grammar": [
        {
          "module": "G0-02",
          "point": "そこ（指前文）",
          "explain": "文章里指代前面刚提过的地方用「そこ」，这里＝那家便利店。口语里指眼前的位置才用「ここ／あそこ」。"
        },
        {
          "module": "G0-03",
          "point": "で／を",
          "explain": "「そこで」动作发生的场所，「コーヒーを」动作的对象。基本语序：谁は＋时间＋地点で＋东西を＋动词。「毎朝」不是具体时刻，后面不加「に」。"
        }
      ],
      "vocab": [
        { "word": "毎朝", "reading": "まいあさ", "pos": "名詞", "zh": "每天早上" },
        { "word": "そこ", "reading": "そこ", "pos": "代名詞", "zh": "那里" },
        { "word": "コーヒー", "reading": "こーひー", "pos": "名詞", "zh": "咖啡" },
        { "word": "買います", "reading": "かいます", "pos": "動詞", "zh": "买" }
      ],
      "isSentenceEnd": true
    },
    {
      "id": "l05",
      "jp": "コンビニの隣は本屋です。",
      "reading": "こんびにのとなりはほんやです。",
      "romaji": "konbini no tonari wa hon'ya desu.",
      "furigana": [
        { "start": 5, "len": 1, "ruby": "となり" },
        { "start": 7, "len": 2, "ruby": "ほんや" }
      ],
      "zh": "便利店旁边是书店。",
      "grammar": [
        {
          "module": "G0-01",
          "point": "〔场所〕は〔东西〕です",
          "explain": "以位置为话题说明「那儿是什么」，用名词句即可，不必说「あります」。"
        }
      ],
      "vocab": [
        { "word": "本屋", "reading": "ほんや", "pos": "名詞", "zh": "书店", "note": "～屋（や）＝某类店：パン屋（面包店）、花屋（花店）" }
      ],
      "isSentenceEnd": true
    },
    {
      "id": "l06",
      "jp": "本屋には日本語の本や雑誌がたくさんあります。",
      "reading": "ほんやにはにほんごのほんやざっしがたくさんあります。",
      "romaji": "hon'ya ni wa Nihongo no hon ya zasshi ga takusan arimasu.",
      "furigana": [
        { "start": 0, "len": 2, "ruby": "ほんや" },
        { "start": 4, "len": 3, "ruby": "にほんご" },
        { "start": 8, "len": 1, "ruby": "ほん" },
        { "start": 10, "len": 2, "ruby": "ざっし" }
      ],
      "zh": "书店里有很多日语书、杂志什么的。",
      "grammar": [
        {
          "module": "G0-03",
          "point": "には",
          "explain": "「に」后面再加「は」，把地点提为话题：「说到书店嘛，那里有……」。助词叠用时「は」总放在最后。"
        },
        {
          "module": "G0-03",
          "point": "や",
          "explain": "「本や雑誌」＝书、杂志等，举例式列举。"
        }
      ],
      "vocab": [
        { "word": "雑誌", "reading": "ざっし", "pos": "名詞", "zh": "杂志" },
        { "word": "たくさん", "reading": "たくさん", "pos": "副詞", "zh": "很多" }
      ],
      "isSentenceEnd": true
    },
    {
      "id": "l07",
      "jp": "会社の中に食堂はありません。",
      "reading": "かいしゃのなかにしょくどうはありません。",
      "romaji": "kaisha no naka ni shokudō wa arimasen.",
      "furigana": [
        { "start": 0, "len": 2, "ruby": "かいしゃ" },
        { "start": 3, "len": 1, "ruby": "なか" },
        { "start": 5, "len": 2, "ruby": "しょくどう" }
      ],
      "zh": "公司里面没有食堂。",
      "grammar": [
        {
          "module": "G0-04",
          "point": "～は ありません",
          "explain": "存在句的否定常把「が」换成「は」：食堂はありません。「は」在否定句里带「别的也许有，但食堂没有」的对比意味。"
        }
      ],
      "vocab": [
        { "word": "中", "reading": "なか", "pos": "名詞", "zh": "里面" },
        { "word": "食堂", "reading": "しょくどう", "pos": "名詞", "zh": "食堂" }
      ],
      "isSentenceEnd": true
    },
    {
      "id": "l08",
      "jp": "ですから、昼ごはんはいつも近くの店で食べます。",
      "reading": "ですから、ひるごはんはいつもちかくのみせでたべます。",
      "romaji": "desu kara, hirugohan wa itsumo chikaku no mise de tabemasu.",
      "furigana": [
        { "start": 5, "len": 1, "ruby": "ひる" },
        { "start": 13, "len": 1, "ruby": "ちか" },
        { "start": 16, "len": 1, "ruby": "みせ" },
        { "start": 18, "len": 1, "ruby": "た" }
      ],
      "zh": "所以午饭我总是在附近的店里吃。",
      "grammar": [
        {
          "module": "G0-01",
          "point": "ですから／だから",
          "explain": "「所以」，放句首承接上句的原因。「だから」是它的普通体，朋友之间说；写礼貌文、对上司用「ですから」。"
        }
      ],
      "vocab": [
        { "word": "ですから", "reading": "ですから", "pos": "接続詞", "zh": "所以" },
        { "word": "店", "reading": "みせ", "pos": "名詞", "zh": "店" }
      ],
      "isSentenceEnd": true
    },
    {
      "id": "l09",
      "jp": "ときどき田中さんもいっしょです。",
      "reading": "ときどきたなかさんもいっしょです。",
      "romaji": "tokidoki Tanaka-san mo issho desu.",
